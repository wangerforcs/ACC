(define (problem LIBERO_Dynamic_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the cream cheese and place it on the moving plate)
    (:regions
      (plate_region
          (:target floor)
          (:ranges (
              (-0.26 -0.26 -0.24 -0.24)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.05 -0.22 0.1 -0.17)
            )
          )
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    cream_cheese_1 - cream_cheese
    plate_1 - plate
  )

  (:obj_of_interest
    cream_cheese_1
    plate_1
  )

  (:init
    (On cream_cheese_1 floor_target_object_region)
    (On plate_1 floor_plate_region)
  )

  (:goal
    (And (On cream_cheese_1 plate_1))
  )

)
