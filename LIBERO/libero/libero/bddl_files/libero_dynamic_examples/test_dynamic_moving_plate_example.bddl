(define (problem LIBERO_Dynamic_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq sauce and place it on the moving plate)
    (:regions
      (plate_region
          (:target floor)
          (:ranges (
              (-0.1 -0.26 -0.08 -0.24)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    plate_1 - plate
  )

  (:obj_of_interest
    bbq_sauce_1
    plate_1
  )

  (:init
    (On bbq_sauce_1 floor_target_object_region)
    (On plate_1 floor_plate_region)
  )

  (:goal
    (And (On bbq_sauce_1 plate_1))
  )

)
