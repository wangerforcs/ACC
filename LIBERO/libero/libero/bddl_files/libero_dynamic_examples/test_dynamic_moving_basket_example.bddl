(define (problem LIBERO_Dynamic_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the bbq sauce and place it in the moving basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.1 0.06 -0.08 0.08)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.075 -0.075)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    basket_1 - basket
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On bbq_sauce_1 floor_target_object_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
